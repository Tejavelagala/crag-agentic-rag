# Copy this file to .env for local development. Values are placeholders only.
CRAG_ENVIRONMENT=development
CRAG_DEBUG=false
CRAG_LOG_LEVEL=INFO
CRAG_LOG_JSON=false
CRAG_PROVIDER_MODE=local
CRAG_ENABLE_OPENAI=false
CRAG_OPENAI_API_KEY=
CRAG_OPENAI_CHAT_MODEL=gpt-4o-mini
CRAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CRAG_ENABLE_TAVILY=false
CRAG_TAVILY_API_KEY=
CRAG_ENABLE_QDRANT=false
CRAG_QDRANT_URL=
CRAG_QDRANT_API_KEY=
CRAG_QDRANT_COLLECTION_NAME=crag_chunks
CRAG_OLLAMA_QDRANT_COLLECTION_NAME=crag_chunks_ollama
CRAG_ENABLE_OLLAMA=false
CRAG_OLLAMA_BASE_URL=http://localhost:11434
CRAG_OLLAMA_CHAT_MODEL=qwen2.5:3b
CRAG_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
CRAG_INTEGRATION_QDRANT_COLLECTION=crag_integration_openai
CRAG_INTEGRATION_OLLAMA_QDRANT_COLLECTION=crag_integration_ollama
CRAG_DOCUMENT_STORAGE_DIR=data/documents
CRAG_DOCUMENT_REGISTRY_PATH=data/documents.sqlite3
CRAG_UPLOADED_COLLECTION_NAME=crag_uploaded_chunks
CRAG_MAX_UPLOAD_SIZE_BYTES=10485760
CRAG_DOCUMENT_PARENT_SIZE=2000
CRAG_DOCUMENT_CHILD_SIZE=500
CRAG_DOCUMENT_CHUNK_OVERLAP=50
